{
  "name": "liro-storybook",
  "version": "0.0.0",
  "private": true,
  "license": "UNLICENSED",
  "description": "The Liro Design System catalogue and playground. Reads its stories from packages/ui.",
  "type": "module",
  "scripts": {
    "storybook": "storybook dev --port 6006",
    "build-storybook": "storybook build && node ../../scripts/copy-legal.mjs storybook-static",
    "typecheck": "tsc -p tsconfig.json",
    "test:stories": "playwright test tests/stories.spec.ts",
    "test:a11y": "playwright test tests/accessibility.spec.ts",
    "test:visual": "playwright test tests/visual.spec.ts"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@veljaos/tokens": "workspace:*",
    "@playwright/test": "1.63.0",
    "@storybook/addon-a11y": "10.6.0",
    "@storybook/addon-docs": "10.6.0",
    "@storybook/react-vite": "10.6.0",
    "@tailwindcss/vite": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storybook": "10.6.0",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0"
  }
}
