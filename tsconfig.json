{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "types": ["node"],
    // eslint.config.mjs imports packages/eslint-config/src/index.ts, which Node runs by stripping types.
    "allowImportingTsExtensions": true
  },
  "include": ["*.mjs", "*.ts", "scripts/**/*.mjs", "packages/*/scripts/**/*.mjs"]
}
