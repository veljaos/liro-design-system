{
  "name": "liro-design-system",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@12.6.0",
  "engines": {
    "node": ">=24.0.0 <25.0.0",
    "pnpm": "12.6.0"
  },
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc -p tsconfig.json && pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test && node --test \"scripts/*.test.mjs\"",
    "build": "pnpm -r --if-present build",
    "consumer-check": "node scripts/consumer-check.mjs",
    "storybook": "pnpm --filter liro-storybook storybook",
    "build-storybook": "pnpm --filter liro-storybook build-storybook",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@types/eslint-plugin-jsx-a11y": "6.10.1",
    "@types/node": "24.13.6",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.12.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  }
}
