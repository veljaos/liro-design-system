{
  "name": "@veljaos/eslint-config",
  "version": "0.1.0-alpha.0",
  "description": "ESLint rules for applications built on the Liro Design System.",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/veljaos/liro-design-system.git",
    "directory": "packages/eslint-config"
  },
  "type": "module",
  "exports": {
    ".": {
