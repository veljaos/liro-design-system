{
  "name": "@liro/eslint-config",
  "version": "2.0.0-alpha.0",
  "description": "ESLint rules for applications built on the Liro Design System.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "eslint": ">=9.0.0"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "tsup": "8.5.1"
  }
}
